{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-youtube-transcripts",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *", "*/2 * * * *"]
  },
  "vars": {
    "PUBLIC_TRANSCRIPT_ORIGIN": "https://discord-youtube-transcripts.kaiguy432.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FAST_INTAKE",
        "class_name": "FastIntakeCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FastIntakeCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-youtube-transcripts",
      "database_id": "6bf847a7-a88d-4f98-82ff-4eb0d5b9273b",
      "migrations_dir": "migrations"
    }
  ]
}
